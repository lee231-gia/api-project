            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Finish CRUD API project\",\n  \"category\": \"School\",\n  \"term\": \"Short Term\",\n  \"status\": \"Completed\",\n  \"due_date\": \"2026-06-10\",\n  \"notes\": \"Update request changes the row with the id in the query string.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/goals?id={{goal_id}}",
          "host": ["{{base_url}}"],
