      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": ["{{base_url}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "List Goals",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/goals",
          "host": ["{{base_url}}"],
          "path": ["api", "goals"]
        }
      }
    },
    {
      "name": "Filter Goals",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/goals?category=School&term=Short%20Term&status=In%20Progress&search=php",
          "host": ["{{base_url}}"],
          "path": ["api", "goals"],
          "query": [
            {
              "key": "category",
              "value": "School"
            },
            {
              "key": "term",
              "value": "Short Term"
            },
            {
              "key": "status",
              "value": "In Progress"
            },
            {
              "key": "search",
              "value": "php"
            }
          ]
        }
      }
    },
    {
      "name": "Get Goal By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/goals?id={{goal_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "goals"],
          "query": [
            {
              "key": "id",
              "value": "{{goal_id}}"
            }
          ]
        }
      }
    },
    {
