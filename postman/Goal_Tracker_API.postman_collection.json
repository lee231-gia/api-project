          "raw": "{\n  \"title\": \"Finish CRUD API project\",\n  \"category\": \"School\",\n  \"term\": \"Short Term\",\n  \"status\": \"In Progress\",\n  \"due_date\": \"2026-06-10\",\n  \"notes\": \"Practice explaining every file before the virtual defense.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/goals",
